# ---------------------------------------------------------------------------
# Spellstutter environment
# Copy to `.env.local` for local dev and set the same names as GitHub Actions
# secrets / repository variables for the sync workflows.
# ---------------------------------------------------------------------------

# Postgres + Auth (Supabase). Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by billing webhooks. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin, used for auth redirects. Set this in production so
# redirects never trust a spoofable Host / x-forwarded-host header.
# Leave unset locally to fall back to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas (Pauper card catalog + metagame data).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=spellstutter

# Scryfall asks for a descriptive User-Agent and contact on bulk API usage.
# https://scryfall.com/docs/api#user-agent
SCRYFALL_USER_AGENT=spellstutter/0.1 (+https://github.com/YOUR-ORG/spellstutter)

# Metagame source switches. MTGO, Melee, Cardsrealm, and MTGTop8 are on by
# default; endstep's metagame endpoint is stale, so it is off unless enabled.
METAGAME_MTGO_ENABLED=true
METAGAME_MELEE_ENABLED=true
METAGAME_CARDSREALM_ENABLED=true
METAGAME_MTGTOP8_ENABLED=true
METAGAME_ENDSTEP_ENABLED=false

# ---------------------------------------------------------------------------
# Monetization (all optional; disabled means the app is fully free)
# ---------------------------------------------------------------------------
MONETIZATION_ENABLED=false
AFFILIATE_LINKS_ENABLED=false
DONATIONS_ENABLED=false
# Require an active Patreon membership for premium analytics. Gating only
# activates when the Patreon OAuth credentials below are configured.
PREMIUM_GATING_ENABLED=true

# Support channel: patreon | custom | none.
SUPPORT_PROVIDER=patreon

# Patreon support link (donation). No feature is gated behind Patreon.
PATREON_URL=

# Optional: link Patreon accounts to show a supporter badge. Create a v2 OAuth
# client at https://www.patreon.com/portal/registration/register-clients and
# request the identity and identity.memberships scopes.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
# Webhook signing secret from the Patreon webhook configuration.
PATREON_WEBHOOK_SECRET=
# Optional override; defaults to <site origin>/api/patreon/callback.
PATREON_REDIRECT_URI=
# Minimum active pledge in cents to count as a supporter (0 = any active pledge).
PATREON_MIN_CENTS=0

# Affiliate links (server-side only).
AFFILIATE_TCGPLAYER_URL=
AFFILIATE_MANAPOOL_URL=
AFFILIATE_CARDKINGDOM_URL=
# Optional: {cards} is replaced with the URL-encoded deck list.
AFFILIATE_DECK_BUY_URL_TEMPLATE=

# Custom support link, used when SUPPORT_PROVIDER=custom.
DONATION_URL=
DONATION_LABEL=Support Spellstutter
